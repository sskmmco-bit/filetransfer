# Copy to .env and adjust. Django reads this file at startup (no Docker —
# services run on the host, so hosts default to 127.0.0.1/localhost).
# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1:8000

# Fernet key for encrypting SMTP/LDAP secrets at rest (§5.11).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# Trusted reverse proxy (nginx). In prod set to the address nginx connects from.
TRUSTED_PROXY_IPS=127.0.0.1,::1
DJANGO_SECURE_SSL=False

# Auto-create a superuser on first boot (optional; remove in prod).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=adminpass123

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=mmftp
POSTGRES_USER=mmftp
POSTGRES_PASSWORD=mmftp
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Cache: in-process LocMemCache (no Redis). Nothing to configure here.
# Background jobs run on systemd timers (prod) or by hand (dev), not Celery.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# File storage (local disk — no MinIO/S3)
# ---------------------------------------------------------------------------
# Where file blobs are stored. Dev default is <repo>/media/files; on a server
# use a writable data dir (e.g. /var/lib/mmftp/files).
FILE_STORAGE_ROOT=media/files
# Delivery: in prod nginx serves blobs via X-Accel-Redirect (set True); in dev
# Django streams them itself (False). Defaults to (not DEBUG) if unset.
FILE_STORAGE_USE_X_ACCEL=False
# Internal nginx location that aliases FILE_STORAGE_ROOT (must match nginx conf).
FILE_STORAGE_X_ACCEL_PREFIX=/_protected/

# ---------------------------------------------------------------------------
# Email (console backend by default; SMTP wired in Phase 4)
# ---------------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=mmftp@example.com
