# ============================================================
# MMFileTransfer — production env template (no-Docker Linux server)
# ------------------------------------------------------------
# Reference for a hand install (see deploy/INSTALL_NO_DOCKER.md). Copy to
# /opt/mmftp/.env on the server and replace EVERY CHANGE_ME_* value. Services
# run on the host, so the app reaches them over 127.0.0.1.
#
#   chmod 600 .env   # contains secrets
#
# Generators (run on any machine that has the tools):
#   DJANGO_SECRET_KEY      python -c "import secrets;print(secrets.token_urlsafe(64))"
#   SECRETS_ENCRYPTION_KEY python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
#                          (or:  openssl rand -base64 32 | tr '+/' '-_' )
# ============================================================

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
DJANGO_DEBUG=False
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

# Production applies committed migrations only; never generate them at boot.
DJANGO_SKIP_MAKEMIGRATIONS=1

# The server's IP (or hostname) that users type in the browser, plus loopback.
DJANGO_ALLOWED_HOSTS=CHANGE_ME_SERVER_IP,localhost,127.0.0.1,[::1]

# Must list the exact scheme+host users hit. Use https://... once TLS is on.
CSRF_TRUSTED_ORIGINS=http://CHANGE_ME_SERVER_IP

# Fernet key encrypting SMTP/LDAP secrets at rest (§5.11). REQUIRED in prod.
SECRETS_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# Trusted reverse proxy: the host nginx talks to Gunicorn over loopback, so the
# proxy address is 127.0.0.1. With this set, audit logs record the real client
# IP, not the proxy. See apps/core/utils.py::get_client_ip.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Set True only after TLS is terminated at the host nginx (forces https redirect).
DJANGO_SECURE_SSL=False

# Initial superuser, created on first boot (idempotent). Change the password.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@mm.co.in
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ---------------------------------------------------------------------------
# PostgreSQL  (must match the role/password you created in psql — see
# INSTALL_NO_DOCKER.md Step 4.)
# ---------------------------------------------------------------------------
POSTGRES_DB=mmftp
POSTGRES_USER=mmftp
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis (Django cache only — background jobs run on systemd timers, not Celery)
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# ---------------------------------------------------------------------------
# Loopback endpoint used for all server-side operations.
MINIO_ENDPOINT_URL=http://127.0.0.1:9000

# Browser-reachable endpoint used to SIGN presigned download/preview URLs.
# Must be the SAME host users hit, because the SigV4 signature binds to it.
# Files are proxied through nginx at /<bucket>/ so this is just the base URL.
# Switch to https://CHANGE_ME_SERVER_IP once TLS is enabled.
MINIO_PUBLIC_ENDPOINT_URL=http://CHANGE_ME_SERVER_IP

MINIO_BUCKET=mmftp-files
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_USE_SSL=False
MINIO_REGION=us-east-1

# ---------------------------------------------------------------------------
# Email
#   Air-gapped with no SMTP relay: keep the console backend (emails are logged,
#   not sent). If an internal relay exists, switch the backend to SMTP and wire
#   host/port/credentials in the in-app Site Settings (/console/) instead.
# ---------------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=mmftp@mm.co.in
